{
  "name": "my-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:analytics": "node --experimental-strip-types --test tests/analytics.test.mjs",
    "test:analytics:live": "node tests/analytics-live.mjs",
    "test:replay": "node --experimental-strip-types --test tests/replay-model.test.mjs",
    "test:replay:live": "node tests/replay-live.mjs",
    "test:scanner-window": "node --test tests/alertWindow.test.mjs",
    "test:smart-money": "node --experimental-strip-types --test tests/smartMoneyEngine.test.mjs",
    "test:backtest": "playwright test --config playwright.backtest.config.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.13.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^12.23.26",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.69.0",
    "react-router-dom": "^7.11.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "technicalindicators": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^1.0.35",
    "zod": "^4.2.1"
